{
  "name": "agent-memory-mcp",
  "version": "0.2.2",
  "private": true,
  "description": "Local-first memory MCP server for Node.js 24 and Windows",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "agent-memory-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=60000 tests/unit/*.test.ts tests/integration/*.test.ts tests/contract/*.test.ts",
    "test:smoke": "node --test --test-timeout=60000 tests/contract/mcp.test.ts",
    "start": "node dist/index.js",
    "dev": "node src/index.ts",
    "check": "pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~5.9.3"
  }
}
